{
  "name": "dsh-sketch-draft",
  "version": "1.2.1",
  "description": "DSH 插件：输入框「+」旁的画板，随手画一张直接作为图片附件放进对话。纯客户端交付（conversation.createDrafts + composer.addAttachments），不依赖宿主 typert 端点，因此在 dsh 0.2.x 上不会出现「support 端点不可用」。Fork of LLYlab/dsh-sketch-draft.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "sketch",
    "draft",
    "canvas",
    "draw",
    "image",
    "attachment"
  ],
  "license": "MIT",
  "author": "LLYlab (upstream 1.0.0); dyguests (fork 1.1.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyguests/dsh-sketch-draft.git"
  },
  "homepage": "https://github.com/dyguests/dsh-sketch-draft#readme",
  "bugs": {
    "url": "https://github.com/dyguests/dsh-sketch-draft/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/bundle.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
